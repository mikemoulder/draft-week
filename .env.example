# Every key the project reads, with an empty value and where it comes from.
# Never commit real values.

# ── Backend: ./.env next to docker-compose.yml on the VPS (chmod 600) ─────
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
# Shared with Vercel. The API rejects requests without it. Generate: openssl rand -hex 32
PROXY_SECRET=
# Public origin of the web app (sign-in message, cookie). e.g. https://draft-week.vercel.app
WEB_ORIGIN=
# Only for running the API outside docker (npm run dev:api). Compose builds its own.
# postgres://draftweek:<POSTGRES_PASSWORD>@127.0.0.1:5440/draftweek
DATABASE_URL=

# ── Web: Vercel project settings ───────────────────────────────────────────
# https://draftweek-api.duckdns.org. Where /api/* is forwarded
API_ORIGIN=
# PROXY_SECRET: same value as the backend
