# Every key the project reads, with an empty value and where it comes from.
# Real values live in apps/api/.env on the VPS (chmod 600) and in Vercel project settings. Never commit them.

# ── API + ingest (VPS, apps/api/.env) ──────────────────────────────────────
# Postgres in docker compose. Generate the password locally: openssl rand -hex 24
POSTGRES_PASSWORD=
# postgres://draftweek:<POSTGRES_PASSWORD>@db:5432/draftweek inside compose, 127.0.0.1:5440 from the host
DATABASE_URL=
# Shared with Vercel. The API rejects requests without it. Generate: openssl rand -hex 32
PROXY_SECRET=
# Public origin of the web app, used in the sign-in message and the cookie
WEB_ORIGIN=

# ── Web (Vercel project settings) ──────────────────────────────────────────
# https://draftweek-api.duckdns.org. The rewrite target for /api/*
API_ORIGIN=
# Also set PROXY_SECRET in Vercel, with the same value as on the VPS (above)
